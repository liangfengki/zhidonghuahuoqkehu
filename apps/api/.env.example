# =============================================================================
# 企业获客平台 - API 环境变量配置
# =============================================================================

# ---- 数据库配置 (必需) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/b2b_lead_gen
DIRECT_URL=postgresql://postgres:password@localhost:5432/b2b_lead_gen

# ---- JWT 认证 (必需) ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# ---- 服务端口 ----
PORT=3001

# ---- Redis 队列 (必需) ----
REDIS_URL=redis://localhost:6379

# ---- CORS 配置 ----
FRONTEND_URL=http://localhost:3000

# ---- 邮件发送渠道 (至少配置一个) ----
# Brevo (原 Sendinblue) - 免费额度 300封/天
BREVO_API_KEY=your-brevo-api-key

# Resend - 免费额度 100封/天
RESEND_API_KEY=your-resend-api-key

# Mailgun - 免费额度 500封/月
# 格式: domain:apikey (例如: mg.example.com:key-xxxx)
MAILGUN_API_KEY=your-mailgun-domain-apikey

# Mailjet - 免费额度 200封/天
# 格式: apikey:secretkey
MAILJET_API_KEY=your-mailjet-apikey-secretkey

# ---- 邮箱验证服务 (可选) ----
# RapidEmailVerifier - 自部署服务
RAPID_EMAIL_VERIFIER_URL=http://localhost:8000

# Sniffmail - 商用 API
SNIFFMAIL_API_KEY=your-sniffmail-api-key

# ---- Supabase (可选, 用于文件存储) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key

# ---- AI 引擎 (可选, 用于自动写邮件) ----
# OpenRouter API Key (免费模型: deepseek/deepseek-v4-flash:free)
# 用户可在前端设置页面配置，此处为默认值
# AI_API_URL=https://openrouter.ai/api/v1/chat/completions
# AI_API_KEY=your-openrouter-api-key
# AI_MODEL=deepseek/deepseek-v4-flash:free

# ---- 邮件追踪 (可选) ----
TRACKING_BASE_URL=http://localhost:3001

# ---- 日志级别 ----
LOG_LEVEL=info
